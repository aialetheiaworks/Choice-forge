# Copy this file to .env and fill in only the keys you need (see
# API_KEYS.md for the full reference). .env is gitignored -- never commit
# real keys.

# Which provider llm_client.py sends the confirmed master prompt to.
# One of: gemini | anthropic | ollama
LLM_PROVIDER=gemini

# --- Gemini (Google) ---
GEMINI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Ollama (local, self-hosted -- no key needed) ---
# Recommended model for this project: qwen2.5:7b-instruct (`ollama pull` it
# first). See API_KEYS.md / CLAUDE.md for why.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct

# --- CHOICE Bucket Matching Engine (reflection prompts, Phase B) ---
# Optional -- bucket_client.py falls back to the current hosted default if
# unset. Override only to point at a different deployment or a local run.
# BUCKET_API_URL=https://choice-bucket-matching.onrender.com
